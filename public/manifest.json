{
  "manifest_version": 3,
  "name": "ReviewReply — AI replies for Google reviews",
  "short_name": "ReviewReply",
  "version": "0.1.0",
  "description": "Drafts on-brand replies to Google Business reviews with AI, using your own playbook of situations. You always post.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Open ReviewReply", "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" } },
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "options_page": "options.html",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["https://api.openai.com/*"],
  "content_scripts": [
    {
      "matches": [
        "https://business.google.com/*",
        "https://www.google.com/*",
        "https://www.google.lt/*",
        "https://www.google.co.uk/*",
        "https://www.google.ie/*",
        "https://www.google.de/*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
